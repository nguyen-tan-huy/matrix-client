<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ForegroundSyncService — keeps the matrix sync loop running (and
         notifications real-time) while the app isn't in the foreground.
         Android requires declaring the specific foreground-service type
         alongside the base permission since API 34. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Lets MainActivity prompt the user to exempt this app from Android's
         standard battery-optimization killing (Doze/App Standby). Needed on
         top of the foreground service above — without this exemption, stock
         Android can still freeze the sync worker's network access in Doze.
         MIUI/HyperOS and other OEM skins layer their own separate,
         non-standard kill switches on top that this permission does NOT
         cover (see ForegroundSyncService's doc comment). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Voice messages (Command::SendVoiceMessage) — the compose box
         records via getUserMedia() in the WebView, which on Android is
         backed by this native permission rather than a JS-level prompt. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.matrix_tauri_client"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="matrixtauriclient" />
                
                
                
                
                
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <service
          android:name=".ForegroundSyncService"
          android:foregroundServiceType="dataSync"
          android:exported="false" />

        <!-- UnifiedPush push receiver — the distributor app (e.g. ntfy)
             delivers to this via the `PUSH_EVENT` broadcast below, which
             Android will start this app's process for even if it was
             fully killed. See `UnifiedPushServiceImpl.kt`'s doc comment. -->
        <service
          android:name=".UnifiedPushServiceImpl"
          android:exported="false">
          <intent-filter>
            <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
          </intent-filter>
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
